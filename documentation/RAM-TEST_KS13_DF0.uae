; RAM-TEST V3.11 — Amiberry configuration (Kickstart 1.3, DF0 boot)
;
; Install:
;   1. Copy this file to:  ~/Documents/Amiberry/Configurations/
;   2. Copy ADF to:        ~/Documents/Amiberry/Floppies/
;        extracted_ramtest/RAM-TEST_emulator.adf
;   3. ROM must be Kickstart 1.3: kick34005.A500.rom (v34.005) in ROMs/
;   4. In Amiberry: Configurations → RAM-TEST_KS13_DF0 → Start
;
; Guru "80000004" / "-000004" at PC "0000A880" = illegal instruction.
; Usually fixed by: exact KS 1.3 ROM, 512K chip + 512K slow, no CPU turbo/JIT.
; See documentation/AMIBERRY-RAM-TEST.txt
;
; Display: RAM-TEST does NOT change screen mode or font. It needs ~80 text columns (HiRes 640px).
; LoRes (320px) = ~40 columns -> long lines wrap to the left (broken logo / MELDUNG box).
; HiRes from power-on + single scanlines + 2x integer window (1280x512).
;
config_description=RAM-TEST V3.11 - A500 OCS 512K+512K slow, max 68000 compat
config_hardware=true
config_host=true
config_version=8.1.6
config_hardware_path=
config_host_path=
config_all_path=
amiberry.rom_path=/Users/markusvankempen/Documents/Amiberry/ROMs/
amiberry.floppy_path=/Users/markusvankempen/Documents/Amiberry/Floppies/
amiberry.hardfile_path=/Users/markusvankempen/Documents/Amiberry/HardDrives/
amiberry.cd_path=/Users/markusvankempen/Documents/Amiberry/CDROMs/
; host-specific
amiberry.middle_mouse=true
amiberry.soundcard=0
amiberry.soundcardname=MacBook Pro Speakers
amiberry.expansion_gui_page=scsi_a3000
; common
use_gui=yes
use_debugger=false
kickstart_rom_file=kick34005.A500.rom
flash_file=
cart_file=
rtc_file=
kickshifter=false
scsidevice_disable=false
floppy_volume=33
floppy0=/Users/markusvankempen/Documents/Amiberry/Floppies/RAM-TEST_emulator.adf
floppy1=
floppy1type=-1
floppy2=
floppy3=
nr_floppies=1
floppy_speed=100
cd_speed=100
parallel_on_demand=false
serial_on_demand=false
serial_hardware_ctsrts=true
serial_status=true
serial_direct=false
scsi=false
uaeserial=false
sana2=false
sound_output=exact
sound_channels=stereo
sound_stereo_separation=7
sound_stereo_mixing_delay=0
sound_max_buff=3072
sound_frequency=44100
sound_interpol=anti
sound_filter=emulated
sound_filter_type=standard
sound_volume=0
sound_volume_paula=0
sound_volume_cd=0
sound_volume_ahi=0
sound_volume_midi=0
sound_volume_genlock=0
sound_auto=false
sound_stereo_swap_paula=false
sound_stereo_swap_ahi=false
comp_trustbyte=indirect
comp_trustword=indirect
comp_trustlong=indirect
comp_trustnaddr=indirect
comp_nf=true
comp_constjump=true
comp_flushmode=soft
compfpu=false
comp_catchfault=true
comp_oldsegv=true
cachesize=0
joyport0=mouse
joyport0autofire=none
joyportfriendlyname0=System mouse
joyportname0=MOUSE0
joyport1=joy0
joyport1autofire=none
bsdsocket_emu=false
synchronize_clock=false
maprom=0x0
parallel_postscript_emulation=false
parallel_postscript_detection=false
ghostscript_parameters=
parallel_autoflush=5
gfx_display=0
gfx_display_rtg=0
gfx_framerate=1
; 2x integer scale of PAL HiRes 640x256 (RAM-TEST console is 640x240)
gfx_width=1280
gfx_height=512
gfx_x_windowed=100
gfx_y_windowed=80
gfx_width_windowed=1280
gfx_height_windowed=512
gfx_width_fullscreen=1280
gfx_height_fullscreen=720
gfx_refreshrate=0
; Fixed HiRes at boot (program never calls SetScreen; autoswitch may stay in LoRes too long)
; CRITICAL: Must be HiRes (640px) for proper logo/text layout. LoRes (320px) causes text bleeding.
gfx_autoresolution=0
gfx_autoresolution_vga=false
gfx_backbuffers=2
gfx_backbuffers_rtg=1
gfx_vsync=true
gfx_vsyncmode=normal
gfx_vsync_picasso=false
gfx_vsyncmode_picasso=normal
gfx_lores=false
gfx_resolution=hires
gfx_lores_mode=normal
gfx_flickerfixer=false
gfx_linemode=single
gfx_fullscreen_amiga=false
gfx_fullscreen_picasso=false
gfx_center_horizontal=smart
gfx_center_vertical=smart
gfx_keep_aspect=true
gfx_correct_aspect=true
gfx_auto_crop=false
gfx_auto_height=false
gfx_correct_aspect=false
scaling_method=-1
gfx_filter_upscale=0
gfx_overscanmode=0
gfx_colour_mode=32bit
gfx_api=sdl3
gfx_api_options=hardware
immediate_blits=false
ntsc=false
genlock=false
chipset=OCS
chipset_refreshrate=49.920410
collision_level=full
chipset_compatible=A500
display_optimizations=none
rtc=none
resetwarning=false
cia_todbug=true
ide=none
scsi_a3000=false
scsi_a4000t=false
fastmem_size=0
debugmem_start=0x0
debugmem_size=0
mem25bit_size=0
a3000mem_size=0
mbresmem_size=0
z3mem_size=0
z3mem_start=0x40000000
; 512 KB chip + 512 KB trapdoor slow (menu 1 = 0.5 MB test)
bogomem_size=0.5
bogomem_fast=false
gfxcard_hardware_vblank=false
gfxcard_hardware_sprite=false
gfxcard_multithread=false
gfxcard_zerocopy=true
chipmem_size=0.5
cpu_speed=real
cpu_throttle=0.0
cpu_type=68000
cpu_model=68000
cpu_compatible=true
cpu_24bit_addressing=true
cpu_data_cache=false
cpu_multiplier=1
; cycle-exact can Guru in bogomem during CopyMemFast (e.g. PC/addr $00C05128)
cpu_cycle_exact=false
cpu_memory_cycle_exact=false
blitter_cycle_exact=false
cycle_exact=false
fpu_strict=false
rtg_nocustom=true
rtg_modes=0x112
rtg_noautomodes=false
debug_mem=false
log_illegal_mem=true
kbd_lang=us
input.config=0
input.joymouse_speed_analog=100
input.joymouse_speed_digital=10
input.joymouse_deadzone=33
input.joystick_deadzone=33
input.analog_joystick_multiplier=18
input.analog_joystick_offset=-5
input.mouse_speed=100
input.autofire_speed=600
input.autoswitch=true
; *** WHDLoad Booter. Options
whdload_filename=
whdload_game_name=
whdload_uuid=
whdload_slave_default=
whdload_slave_libraries=false
whdload_slave=
whdload_slave_data_path=
whdload_custom1=0
whdload_custom2=0
whdload_custom3=0
whdload_custom4=0
whdload_custom5=0
whdload_custom=
whdload_buttonwait=false
whdload_showsplash=true
whdload_writecache=false
whdload_quit_on_exit=false
